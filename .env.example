# 后端端口（本地开发）
PORT=3001
NODE_ENV=development

# ---- 数据持久化（P1）----
# 外部托管 Postgres（Neon）连接串，带 sslmode=require
# 未配置时应用回退到内存实现（仅开发/测试用，重启即失）
DATABASE_URL=

# ---- LLM（P2 起）----
# DeepSeek API。三者都配置才启用真实模型；缺任一则回退到内置 Fake（离线可跑通完整流程，内容为确定性模板）。
# 申请 key：https://platform.deepseek.com
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com
# 最便宜档（V4.1-Flash）。如需更强可换 deepseek-v4-pro（更贵）
LLM_MODEL=deepseek-flash

# ---- 分享链接（P3+）----
# APP_BASE_URL=        # 部署后的公网地址，用于生成分享链接

# ---- 公网口令门禁 + 限流（P6 方案 B，公网部署用）----
# 访问口令：设置后所有 /api/*（除 /health 与只读 /share/*）需先 POST /api/auth 换 HttpOnly cookie。
# 留空 = 关闭口令（本地开发不被打断）。线上请在 Render 后台 Environment 配置，勿提交真实值。
ACCESS_KEY=
# IP 级每分钟请求数上限（挡脚本刷接口）
RATE_LIMIT_RPM=20
# 全局每日 run 数保险丝：锁死当日 LLM 总费用
MAX_GLOBAL_RUNS_PER_DAY=50
